# Copy to .env (git-ignored) and fill in at least one key to enable the AI agent.

# DeepSeek (OpenAI-compatible API). Models: deepseek-v4-pro (default), deepseek-flash (faster, lighter).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro

# Claude (Anthropic API). Default model claude-opus-5-5 at medium effort.
ANTHROPIC_API_KEY=
# CLAUDE_AGENT_MODEL=claude-opus-5-5
# CLAUDE_AGENT_EFFORT=medium

# With both keys set, DeepSeek is used unless you choose here (deepseek | anthropic).
# LLM_PROVIDER=
