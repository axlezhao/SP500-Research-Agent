# Copy to .env (git-ignored) and fill in what you use.

# --- Live data -------------------------------------------------------------------------------
# SEC EDGAR asks every client to identify itself with a contact email (it won't serve requests without one).
# Example: SEC_USER_AGENT=SP500-Research-Agent you@example.com
SEC_USER_AGENT=

# Optional: Finnhub company news (free key at finnhub.io). Without it, headlines come from Yahoo Finance RSS.
FINNHUB_API_KEY=

# --- AI agent (at least one) -----------------------------------------------------------------
# DeepSeek (OpenAI-compatible API). Models: deepseek-v4-pro (default), deepseek-flash (faster, lighter).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro

# Claude (Anthropic API). Default model claude-opus-5-5 at medium effort.
ANTHROPIC_API_KEY=
# CLAUDE_AGENT_MODEL=claude-opus-5-5
# CLAUDE_AGENT_EFFORT=medium

# With both keys set, DeepSeek is used unless you choose here (deepseek | anthropic).
# LLM_PROVIDER=

# --- Public demo (see docs/DEPLOY.md) ------------------------------------------------------
# DEMO_MODE=1                 # chat limits per visitor/day, admin endpoints locked
# CHAT_LIMIT_PER_HOUR=20
# CHAT_LIMIT_PER_DAY=300
# ADMIN_TOKEN=                # allows POST /api/reload with header X-Admin-Token
